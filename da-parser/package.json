{
  "name": "@adobe/da-parser",
  "version": "1.2.1",
  "description": "Parser for converting DA Admin HTML to DA Live ProseMirror/YDoc format",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema.js",
    "./parser": "./src/parser.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test:browser && npm run test:node",
    "test:browser": "wtr \"./test/*.test.js\" --node-resolve --coverage",
    "test:node": "c8 mocha \"./test/*.test.js\"",
    "prepublishOnly": "npm run lint && npm test",
    "release": "npm publish"
  },
  "mocha": {
    "exit": true
  },
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/da-tools.git",
    "directory": "da-parser"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "3.0.29",
    "@eslint/config-helpers": "0.7.0",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@web/dev-server-import-maps": "0.3.0",
    "@web/test-runner": "1.0.0",
    "@web/test-runner-commands": "1.0.1",
    "c8": "12.0.0",
    "chai": "6.2.2",
    "eslint": "9.4.0",
    "globals": "17.9.0",
    "mocha": "11.8.0"
  },
  "peerDependencies": {
    "yjs": "13.6.32"
  },
  "dependencies": {
    "hast-util-from-html": "2.0.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-tables": "1.8.5",
    "y-prosemirror": "1.3.7"
  }
}
